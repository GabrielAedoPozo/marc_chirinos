<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observar todos los elementos con animaciones
    const animatedElements = document.querySelectorAll('.fade-in-up, .fade-in-left, .fade-in-right');
    animatedElements.forEach(el => observer.observe(el));

    // Services Wheel Interactive System
    const servicesData = [
      {
        icon: 'fa-flask',
        title: 'Ensayos de Eficacia en Campo',
        description: 'Ensayos de eficacia en campo de plaguicidas de uso agrícola con estándares internacionales. Garantizamos resultados precisos y confiables para el registro de productos.',
      },
      {
        icon: 'fa-certificate',
        title: 'Autorización Sanitaria',
        description: 'Autorización sanitaria de establecimientos para procesamiento primario de alimentos agropecuarios y piensos. Cumplimiento total con las normativas SENASA vigentes.',
      },
      {
        icon: 'fa-cow',
        title: 'Autorizaciones Pecuarias',
        description: 'Autorizaciones de camales y granjas pecuarias con cumplimiento regulatorio. Asesoría integral para obtener todos los permisos necesarios para su operación.',
      },
      {
        icon: 'fa-leaf',
        title: 'Saneamiento Ambiental',
        description: 'Servicio integral de saneamiento ambiental para sus operaciones agrícolas. Implementación de protocolos sanitarios y control de plagas conforme a estándares internacionales.',
      },
      {
        icon: 'fa-spray-can',
        title: 'Fumigaciones Agrícolas',
        description: 'Fumigaciones de silos, buques, depósitos y almacenes con técnicas avanzadas. Utilizamos productos autorizados y metodologías certificadas para máxima eficacia.',
      },
      {
        icon: 'fa-biohazard',
        title: 'Tratamiento Cuarentenario',
        description: 'Servicio de tratamiento cuarentenario de productos pecuarios siguiendo protocolos internacionales. Garantizamos el cumplimiento de requisitos fitosanitarios para exportación.',
      },
    ];

    const wheelItems = document.querySelectorAll('.service-wheel-item');
    const infoContent = document.getElementById('serviceInfoContent');

    function showServiceInfo(serviceIndex) {
      const service = servicesData[serviceIndex];
      
      // Eliminar clase active de todos los items
      wheelItems.forEach(item => item.classList.remove('active'));
      
      // Agregar clase active al item seleccionado
      wheelItems[serviceIndex].classList.add('active');

      // Crear el contenido del servicio
      const serviceHTML = `
        <div class="service-detail">
          <div class="service-detail-icon">
            <i class="fa-solid ${service.icon}"></i>
          </div>
          <h3>${service.title}</h3>
          <p>${service.description}</p>
        </div>
      `;

      // Animación de salida
      infoContent.style.opacity = '0';
      infoContent.style.transform = 'translateX(-20px)';

      setTimeout(() => {
        infoContent.innerHTML = serviceHTML;
        infoContent.style.opacity = '1';
        infoContent.style.transform = 'translateX(0)';
      }, 200);
    }

    // Agregar event listeners a cada item de la rueda
    wheelItems.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        showServiceInfo(index);
      });
    });

    // Estilo de transición para el contenido
    infoContent.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
  });
</script>
