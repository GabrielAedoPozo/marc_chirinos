    animation-duration: 11s;
    animation-delay: 1.5s;
    width: 52px;
    top: -280px;
  }

  .leaf-fall-10 {
    left: 20%;
    animation-duration: 14s;
    animation-delay: 7s;
    width: 38px;
    top: -600px;
  }

  .leaf-fall-11 {
    left: 35%;
    animation-duration: 10.5s;
    animation-delay: 3.5s;
    width: 46px;
