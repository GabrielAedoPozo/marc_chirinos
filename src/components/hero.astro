            <img src="/img/hoja.png" alt="" class="absolute top-40 right-16 w-32 opacity-15 transform rotate-60" />
            <img src="/img/hoja.png" alt="" class="absolute top-60 right-4 w-36 opacity-18 transform -rotate-25" />
            
            <!-- Middle right cluster -->
            <img src="/img/hoja.png" alt="" class="absolute top-96 right-20 w-48 opacity-20 transform rotate-35" />
