  .wheel-circle-1 {
    width: 300px;
    height: 300px;
    animation: circleFloat 4s ease-in-out infinite;
  }

  .wheel-circle-2 {
    width: 400px;
    height: 400px;
    animation: circleFloat 6s ease-in-out infinite reverse;
  }

  @keyframes circleFloat {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.05);
    }
