  @keyframes centerPulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      box-shadow: 0 10px 40px rgba(15, 155, 15, 0.4);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.05);
      box-shadow: 0 15px 50px rgba(15, 155, 15, 0.6);
    }
