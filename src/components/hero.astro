              </div>
            </div>
            <div class="bg-white border-l-4 border-green-600 rounded-lg p-4 shadow-md">
              <p class="text text-green-700 text-lg font-semibold">Idiomas</p>
              <p class="text text-gray-700 text-base mt-2">Ingles: Intermedio - Avanzado</p>
              <p class="text text-gray-700 text-base">Portugués: Básico</p>
            </div>
          </div>
        </div>
      </div>

