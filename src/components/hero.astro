    <div class="flex justify-center flex-col items-center">

        <h1
            class="text-6xl md:text-8xl font-extrabold text-center 
                bg-[url('/img/hojas1.png')] 
                bg-cover bg-center 
                bg-clip-text text-transparent">
                Mac Chirinos Hinostroza
        </h1>

        <p class="text-2xl md:text-3xl font-semibold text-center mt-4 text-gray-700">
            Asesor técnico regulatorio
        </p>

        <div class="flex gap-4 mt-8">
            <a href="#contacto" class="btn btn-primary">
                Contáctame
            </a>
            <a href="/cv.pdf" download class="btn btn-secondary">
                Descargar CV
            </a>
        </div>

        <i class="fa-solid fa-arrow-down text text-5xl mt-16 md:mt-20 bounce-arrow"></i>
    </div>
  </section>

</main>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
  }

  .falling-leaf {
    position: absolute;
    width: 50px;
    height: auto;
    opacity: 0.6;
    z-index: 1;
    pointer-events: none;
    animation: fall linear infinite;
  }

  @keyframes fall {
    0% {
      top: -100px;
      transform: rotate(0deg);
    }
    100% {
      top: 100vh;
      transform: rotate(360deg);
    }
  }

  .leaf-fall-1 {
    left: 10%;
    animation-duration: 8s;
    animation-delay: 0s;
    top: -150px;
  }

  .leaf-fall-2 {
    left: 25%;
    animation-duration: 10s;
    animation-delay: 2s;
    width: 40px;
    top: -300px;
  }

  .leaf-fall-3 {
    left: 40%;
    animation-duration: 12s;
    animation-delay: 4s;
    top: -200px;
  }

  .leaf-fall-4 {
    left: 55%;
    animation-duration: 9s;
    animation-delay: 1s;
    width: 45px;
    top: -400px;
  }

  .leaf-fall-5 {
    left: 70%;
    animation-duration: 11s;
    animation-delay: 3s;
    top: -250px;
  }

