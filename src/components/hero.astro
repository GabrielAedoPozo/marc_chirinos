<style>
  main {
    overflow-x: hidden;
    width: 100%;
  }

  .hero-section {
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 15% 20%, rgba(15, 155, 15, 0.12) 0%, transparent 8%),
      radial-gradient(circle at 85% 30%, rgba(6, 78, 6, 0.10) 0%, transparent 10%),
      radial-gradient(circle at 50% 60%, rgba(15, 155, 15, 0.08) 0%, transparent 12%),
      radial-gradient(circle at 25% 75%, rgba(6, 78, 6, 0.09) 0%, transparent 7%),
      radial-gradient(circle at 70% 15%, rgba(15, 155, 15, 0.11) 0%, transparent 9%),
      radial-gradient(circle at 40% 35%, rgba(6, 78, 6, 0.07) 0%, transparent 6%),
      radial-gradient(circle at 90% 70%, rgba(15, 155, 15, 0.10) 0%, transparent 11%),
      radial-gradient(circle at 10% 85%, rgba(6, 78, 6, 0.08) 0%, transparent 8%),
      radial-gradient(circle at 60% 90%, rgba(15, 155, 15, 0.09) 0%, transparent 10%),
      radial-gradient(circle at 30% 50%, rgba(6, 78, 6, 0.06) 0%, transparent 5%),
      linear-gradient(180deg, rgba(15, 155, 15, 0.02) 0%, transparent 100%);
    opacity: 1;
    z-index: 1;
  }

  

  .hero-section > div {
    position: relative;
    z-index: 2;
  }

  .btn {
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: linear-gradient(135deg, #064e06, #0f9b0f);
    color: white;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #0f9b0f, #064e06);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 155, 15, 0.4);
  }

  .btn-secondary {
    background: white;
    color: #064e06;
    border: 2px solid #0f9b0f;
  }

  .btn-secondary:hover {
    background: #0f9b0f;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 155, 15, 0.4);
  }

  .bounce-arrow {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(15px);
    }
  }

  /* Animaciones de entrada */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .fade-in-up {
    opacity: 0;
  }

  .fade-in-left {
    opacity: 0;
  }

  .fade-in-right {
    opacity: 0;
  }

  .fade-in-up.animate {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .fade-in-left.animate {
    animation: fadeInLeft 0.9s ease-out forwards;
  }

  .fade-in-right.animate {
    animation: fadeInRight 0.9s ease-out forwards;
  }

  .skills-section {
    margin-top: 3.5rem;
    padding: 4.5rem 1.5rem;
    background: #ffffff;
  }

  .experience-images {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .exp-image-stack {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 420px;
  }

  .exp-image {
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 18px 35px rgba(10, 98, 35, 0.12);
    border: 1px solid rgba(12, 107, 43, 0.12);
    object-fit: cover;
  }

  .skills-shell {
    max-width: 1280px;
    margin: 0 auto;
  }

  .skills-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .skills-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: #111827;
  }

  .skills-subtitle {
    color: #1f5c32;
    font-size: 1.05rem;
  }

  .skills-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  @media (min-width: 1024px) {
    .skills-grid {
      grid-template-columns: repeat(5, minmax(200px, 1fr));
    }
  }

  .skill-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: 0 18px 35px rgba(10, 98, 35, 0.12);
    border: 1px solid rgba(12, 107, 43, 0.12);
    position: relative;
    overflow: hidden;
  }

  .skill-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(15, 155, 15, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .skill-card:hover::after {
    opacity: 1;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 6px 12px;
    border-radius: 999px;
    background: #0f9b0f;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  .skill-card p {
    margin: 0;
    color: #1f2937;
    line-height: 1.5;
  }
</style>

