  .hero-section > div {
    position: relative;
    z-index: 2;
  }

  .btn {
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: linear-gradient(135deg, #064e06, #0f9b0f);
    color: white;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #0f9b0f, #064e06);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 155, 15, 0.4);
  }

  .btn-secondary {
    background: white;
    color: #064e06;
    border: 2px solid #0f9b0f;
  }

  .btn-secondary:hover {
    background: #0f9b0f;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 155, 15, 0.4);
  }

  .bounce-arrow {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(15px);
    }
  }
</style>
