---
import LogoCarousel from './LogoCarousel.astro';
const whatsappNumber = "51932574949";
const whatsappMessage = "Hola%20Mac%20Chirinos,%20me%20gustaría%20saber%20más...";
const linkedinUrl = "https://www.linkedin.com/in/machirinos-regulation/";
---

<main class="overflow-y-hidden">
  <section class="min-h-screen flex justify-center items-center hero-section">
    

    <div class="flex justify-center flex-col items-center w-full">

      <div class="pt-30 flex flex-col justify-center items-center">
          <p class="mb-10 text text-2xl font-semibold uppercase tracking-[0.35em] text-center bg-gradient-to-r from-green-900 via-green-600 to-green-900 bg-clip-text text-transparent fade-in-up">
            Asesor técnico regulatorio
          </p>
          <h1
              class="text-6xl md:text-8xl font-extrabold text-center 
                  bg-[url('/marc_chirinos/img/hojas1.png')] 
                  bg-cover bg-center 
                  bg-clip-text text-transparent fade-in-up"
              style="animation-delay: 0.2s;">
                  Mac Chirinos Hinostroza
          </h1>


          <div class="flex gap-4 mt-8 fade-in-up" style="animation-delay: 0.4s;">
              <a href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`} class="btn btn-primary">
                  Contáctame
              </a>
              <a href="/cv.pdf" download class="btn btn-secondary">
                  Descargar CV
              </a>
          </div>

        </div>

          <div class="fade-in-up" style="animation-delay: 0.6s;">
            <LogoCarousel />
          </div>

        <i class="fa-solid fa-arrow-down text text-5xl mt-16 md:mt-20 bounce-arrow fade-in-up" style="animation-delay: 0.8s;"></i>
    </div>
  </section>

  <section class="mt-10 about-section">

    <div class="flex flex-none gap-40 justify-center items-center">
      <div class="fade-in-left">
        <h2 class="text text-4xl font-semibold">Acerca de mí</h2>

        <div class="mt-5">
          <p class="text text-gray-600 text-2xl"><span class="text text-green-800 font-semibold">Ingeniero Agrónomo</span> especializado en regulación peruana SENASA <br> y estándares orgánicos internacionales EU, NOP, JAS, RTPO para <br> plaguicidas e insumos agrícolas.</p><br>
          <p class="text text-gray-600 text-2xl">Acompaño a empresas importadoras, formuladores y comercializadores en el <br> cumplimiento normativo ante SENASA y en la evaluación de compatibilidad con <br> estándares orgánicos internacionales (UE, NOP, JAS), ayudándolos a evitar <br> observaciones, rechazos y riesgos regulatorios.</p> <br>
          
          <div class="mt-8 flex flex-col sm:flex-row gap-6 items-start">
            <div class="bg-gradient-to-r from-green-900 to-green-600 rounded-lg p-4 text-white shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all inline-block">
              <div class="flex items-center gap-2 mb-2">
                <i class="fa-solid fa-graduation-cap text-xl"></i>
                <span class="font-semibold text-lg">Educación</span>
              </div>
              <div class="pl-1">
                <p class="font-semibold text-base">Ingeniería Agrónoma</p>
                <p class="text-sm opacity-95">Universidad Nacional Agraria La Molina</p>
              </div>
            </div>
            <div class="bg-white border-l-4 border-green-600 rounded-lg p-4 shadow-md">
              <p class="text text-green-700 text-lg font-semibold">Idiomas</p>
              <p class="text text-gray-700 text-base mt-2">Ingles: Intermedio - Avanzado</p>
              <p class="text text-gray-700 text-base">Portugués: Básico</p>
            </div>
          </div>
        </div>
      </div>

      <div class="fade-in-right">
        <img src="/marc_chirinos/img/mac1.jpeg" alt="" class="h-100 rounded-2xl">
      </div>
    </div>
    
  </section>

  <section class="mt-30 px-4 py-16 services-section">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 fade-in-up">
        <span class="services-gradient-text">Mis Servicios</span>
      </h2>
      <p class="text-center text-gray-600 text-lg mb-12">Selecciona un servicio para conocer más detalles</p>
      
      <div class="services-container">
        {/* Rueda de servicios */}
        <div class="services-wheel-wrapper">
          <div class="services-wheel" id="servicesWheel">
            {/* Centro de la rueda */}
            <div class="wheel-center">
              <div class="wheel-center-glow"></div>
              <i class="fa-solid fa-briefcase text-3xl text-white"></i>
            </div>

            {/* Servicio 1 - Ensayos de Eficacia */}
            <div class="service-wheel-item" data-service="0" style="--angle: 0deg;">
              <div class="service-icon-wrapper">
                <i class="fa-solid fa-flask"></i>
              </div>
            </div>

            {/* Servicio 2 - Autorización Sanitaria */}
            <div class="service-wheel-item" data-service="1" style="--angle: 60deg;">
              <div class="service-icon-wrapper">
                <i class="fa-solid fa-certificate"></i>
              </div>
            </div>

            {/* Servicio 3 - Autorizaciones Pecuarias */}
            <div class="service-wheel-item" data-service="2" style="--angle: 120deg;">
              <div class="service-icon-wrapper">
                <i class="fa-solid fa-cow"></i>
              </div>
            </div>

            {/* Servicio 4 - Saneamiento Ambiental */}
            <div class="service-wheel-item" data-service="3" style="--angle: 180deg;">
              <div class="service-icon-wrapper">
                <i class="fa-solid fa-leaf"></i>
              </div>
            </div>

            {/* Servicio 5 - Fumigaciones */}
            <div class="service-wheel-item" data-service="4" style="--angle: 240deg;">
              <div class="service-icon-wrapper">
                <i class="fa-solid fa-spray-can"></i>
              </div>
            </div>

            {/* Servicio 6 - Tratamiento Cuarentenario */}
            <div class="service-wheel-item" data-service="5" style="--angle: 300deg;">
              <div class="service-icon-wrapper">
                <i class="fa-solid fa-biohazard"></i>
              </div>
            </div>

            {/* Círculos decorativos */}
            <div class="wheel-circle wheel-circle-1"></div>
            <div class="wheel-circle wheel-circle-2"></div>
          </div>
        </div>

        {/* Panel de información del servicio */}
        <div class="service-info-panel" id="serviceInfoPanel">
          <div class="service-info-content" id="serviceInfoContent">
            <div class="service-welcome">
              <i class="fa-solid fa-hand-pointer text-6xl text-green-600 mb-4"></i>
              <h3 class="text-3xl font-bold text-gray-800 mb-3">Selecciona un Servicio</h3>
              <p class="text-gray-600 text-xl">Haz clic en cualquier ícono de la rueda para ver más información</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-30 px-4 py-16 exp-lang-section">
    <div class="max-w-screen-2xl mx-auto px-4">
      <div class="flex flex-col lg:flex-row gap-14 justify-center items-start">
        {/* Experiencia */}
        <div class="flex-1 lg:flex-[1.35]">
          <h2 class="text-3xl md:text-4xl font-semibold mb-12 text-center lg:text-left">Experiencia</h2>
          
          <div class="relative experience-timeline">
            {/* Timeline vertical line */}
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gradient-to-b from-green-600 to-gray-300 timeline-line"></div>
            
            {/* Experience Item 1 */}
            <div class="mb-12 pl-0 sm:pl-20 timeline-item">
              <div class="absolute left-0 w-14 h-14 bg-green-600 rounded-full border-4 border-white flex items-center justify-center text-white timeline-marker">
                <i class="fa-solid fa-briefcase text-lg"></i>
              </div>
              
              <h3 class="text-xl font-bold text-gray-800">Asesor técnico regulatorio (freelance)</h3>
              <p class="text-sm text-gray-500 mt-1">NEXXT TECNOLOGIA Y COMERCIO E.I.R.L</p>
              <p class="text-sm text-gray-500">Noviembre 2025 - Actualidad</p>
              
              <ul class="mt-4 space-y-2 text-gray-700">
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Proporciono asesoría técnica para la obtención de autorización sanitaria.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Gestiono la documentación técnica para obtener los permisos de experimentación de plaguicidas.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Gestiono la documentación técnica para obtener los permisos de comercialización.</span>
                </li>
              </ul>
            </div>

            {/* Experience Item 2 */}
            <div class="mb-12 pl-0 sm:pl-20 timeline-item">
              <div class="absolute left-0 w-14 h-14 bg-green-600 rounded-full border-4 border-white flex items-center justify-center text-white timeline-marker">
                <i class="fa-solid fa-leaf text-lg"></i>
              </div>
              
              <h3 class="text-xl font-bold text-gray-800">Asesor de insumos orgánicos (freelance)</h3>
              <p class="text-sm text-gray-500 mt-1">NEXXT S.A.C.</p>
              <p class="text-sm text-gray-500">Octubre 2025 - Actualidad</p>
              
              <ul class="mt-4 space-y-2 text-gray-700">
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Evalúo y recomiendo insumos aprobados por estándares internacionales</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Gestiono el proceso de evaluación con la certificadora</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Mantengo información actualizada sobre los marcos de regulación orgánica (EU, USDA-NOP, SENASA).</span>
                </li>
              </ul>
            </div>

            {/* Experience Item 3 */}
            <div class="pl-0 sm:pl-20 timeline-item">
              <div class="absolute left-0 w-14 h-14 bg-green-600 rounded-full border-4 border-white flex items-center justify-center text-white timeline-marker">
                <i class="fa-solid fa-clipboard text-lg"></i>
              </div>
              
              <h3 class="text-xl font-bold text-gray-800">Asistente regulatorio (freelance)</h3>
              <p class="text-sm text-gray-500 mt-1">CARANLU E.I.R.L</p>
              <p class="text-sm text-gray-500">Enero 2024 - Presente</p>
              
              <ul class="mt-4 space-y-2 text-gray-700">
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Asisto en la preparación de documentos técnicos, dossiers de productos y solicitudes de permisos para SENASA.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Oriento a formuladores, importadores y exportadores en auditorías y certificaciones comerciales.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-600 font-bold">•</span>
                  <span>Facilito aprobaciones rápidas asegurando el cumplimiento normativo vigente.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <div class="flex-1 lg:flex-[0.9] experience-images">
          <div class="exp-image-stack">
            <img src="/marc_chirinos/img/mac3.jpeg" alt="" class="exp-image fade-in-right" style="animation-delay: 0.2s;" />
            <img src="/marc_chirinos/img/agr.jpg" alt="" class="exp-image fade-in-right" style="animation-delay: 0.4s;" />
            <img src="/marc_chirinos/img/agr2.jpg" alt="" class="exp-image fade-in-right" style="animation-delay: 0.6s;" />
          </div>
        </div>
        

      </div>


    </div>
  </section>

  <section class="mt-30 px-4 py-16 skills-modern-section">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 fade-in-up">
        <span class="skills-gradient-text">Habilidades</span>
      </h2>
      <p class="text-center text-gray-600 text-lg mb-12">Experiencia especializada y competencias clave</p>
      
      <div class="skills-modern-grid">
        {/* Habilidad 1 */}
        <div class="skill-modern-card fade-in-up" style="animation-delay: 0.1s;">
          <div class="skill-image-overlay">
            <img src="/marc_chirinos/img/habilidades1.avif" alt="Cumplimiento de estándares orgánicos" />
            <div class="skill-overlay-gradient"></div>
          </div>
          <div class="skill-modern-content">
            <div class="skill-modern-icon">
              <i class="fa-solid fa-certificate"></i>
            </div>
            <h3 class="skill-modern-title">Cumplimiento de estándares orgánicos</h3>
            <p class="skill-modern-tags">
              <span class="skill-tag">EU 2021/1165</span>
              <span class="skill-tag">USDA 7 CFR Part 205</span>
              <span class="skill-tag">JAS 1605</span>
              <span class="skill-tag">DS 044-2006</span>
            </p>
          </div>
        </div>

        {/* Habilidad 2 */}
        <div class="skill-modern-card fade-in-up" style="animation-delay: 0.2s;">
          <div class="skill-image-overlay">
            <img src="/marc_chirinos/img/habilidades2.webp" alt="Asesoramiento en registro de plaguicidas" />
            <div class="skill-overlay-gradient"></div>
          </div>
          <div class="skill-modern-content">
            <div class="skill-modern-icon">
              <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <h3 class="skill-modern-title">Asesoramiento en registro de plaguicidas</h3>
            <p class="skill-modern-tags">
              <span class="skill-tag">DS 001-2015</span>
              <span class="skill-tag">Resolution 2075</span>
            </p>
          </div>
        </div>

        {/* Habilidad 3 */}
        <div class="skill-modern-card fade-in-up" style="animation-delay: 0.3s;">
          <div class="skill-image-overlay">
            <img src="/marc_chirinos/img/habilidades3.png" alt="Office 365" />
            <div class="skill-overlay-gradient"></div>
          </div>
          <div class="skill-modern-content">
            <div class="skill-modern-icon">
              <i class="fa-solid fa-laptop-code"></i>
            </div>
            <h3 class="skill-modern-title">Office 365</h3>
            <p class="skill-modern-tags">
              <span class="skill-tag">Competencia intermedia</span>
            </p>
          </div>
        </div>

        {/* Habilidad 4 */}
        <div class="skill-modern-card fade-in-up" style="animation-delay: 0.4s;">
          <div class="skill-image-overlay">
            <img src="/marc_chirinos/img/habilidades4.avif" alt="Servicio al cliente" />
            <div class="skill-overlay-gradient"></div>
          </div>
          <div class="skill-modern-content">
            <div class="skill-modern-icon">
              <i class="fa-solid fa-handshake"></i>
            </div>
            <h3 class="skill-modern-title">Servicio al cliente y entrega de reportes</h3>
            <p class="skill-modern-tags">
              <span class="skill-tag">Gestión profesional</span>
            </p>
          </div>
        </div>

        {/* Habilidad 5 */}
        <div class="skill-modern-card fade-in-up" style="animation-delay: 0.5s;">
          <div class="skill-image-overlay">
            <img src="/marc_chirinos/img/habilidades5.jpg" alt="Escritura técnica" />
            <div class="skill-overlay-gradient"></div>
          </div>
          <div class="skill-modern-content">
            <div class="skill-modern-icon">
              <i class="fa-solid fa-file-pen"></i>
            </div>
            <h3 class="skill-modern-title">Escritura técnica y sistemas de trazabilidad</h3>
            <p class="skill-modern-tags">
              <span class="skill-tag">Documentación precisa</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>




<style>
  main {
    overflow-x: hidden;
    width: 100%;
  }

  .hero-section {
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 15% 20%, rgba(15, 155, 15, 0.12) 0%, transparent 8%),
      radial-gradient(circle at 85% 30%, rgba(6, 78, 6, 0.10) 0%, transparent 10%),
      radial-gradient(circle at 50% 60%, rgba(15, 155, 15, 0.08) 0%, transparent 12%),
      radial-gradient(circle at 25% 75%, rgba(6, 78, 6, 0.09) 0%, transparent 7%),
      radial-gradient(circle at 70% 15%, rgba(15, 155, 15, 0.11) 0%, transparent 9%),
      radial-gradient(circle at 40% 35%, rgba(6, 78, 6, 0.07) 0%, transparent 6%),
      radial-gradient(circle at 90% 70%, rgba(15, 155, 15, 0.10) 0%, transparent 11%),
      radial-gradient(circle at 10% 85%, rgba(6, 78, 6, 0.08) 0%, transparent 8%),
      radial-gradient(circle at 60% 90%, rgba(15, 155, 15, 0.09) 0%, transparent 10%),
      radial-gradient(circle at 30% 50%, rgba(6, 78, 6, 0.06) 0%, transparent 5%),
      linear-gradient(180deg, rgba(15, 155, 15, 0.02) 0%, transparent 100%);
    opacity: 1;
    z-index: 1;
  }

  

  .hero-section > div {
    position: relative;
    z-index: 2;
  }

  .btn {
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: linear-gradient(135deg, #064e06, #0f9b0f);
    color: white;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #0f9b0f, #064e06);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 155, 15, 0.4);
  }

  .btn-secondary {
    background: white;
    color: #064e06;
    border: 2px solid #0f9b0f;
  }

  .btn-secondary:hover {
    background: #0f9b0f;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 155, 15, 0.4);
  }

  .bounce-arrow {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(15px);
    }
  }

  /* Animaciones de entrada */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .fade-in-up {
    opacity: 0;
  }

  .fade-in-left {
    opacity: 0;
  }

  .fade-in-right {
    opacity: 0;
  }

  .fade-in-up.animate {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .fade-in-left.animate {
    animation: fadeInLeft 0.9s ease-out forwards;
  }

  .fade-in-right.animate {
    animation: fadeInRight 0.9s ease-out forwards;
  }

  .skills-section {
    margin-top: 3.5rem;
    padding: 4.5rem 1.5rem;
    background: #ffffff;
  }

  .experience-images {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .exp-image-stack {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 420px;
  }

  .exp-image {
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 18px 35px rgba(10, 98, 35, 0.12);
    border: 1px solid rgba(12, 107, 43, 0.12);
    object-fit: cover;
  }

  .skills-shell {
    max-width: 1280px;
    margin: 0 auto;
  }

  .skills-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .skills-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: #111827;
  }

  .skills-subtitle {
    color: #1f5c32;
    font-size: 1.05rem;
  }

  .skills-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  @media (min-width: 1024px) {
    .skills-grid {
      grid-template-columns: repeat(5, minmax(200px, 1fr));
    }
  }

  .skill-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: 0 18px 35px rgba(10, 98, 35, 0.12);
    border: 1px solid rgba(12, 107, 43, 0.12);
    position: relative;
    overflow: hidden;
  }

  .skill-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(15, 155, 15, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .skill-card:hover::after {
    opacity: 1;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 6px 12px;
    border-radius: 999px;
    background: #0f9b0f;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  .skill-card p {
    margin: 0;
    color: #1f2937;
    line-height: 1.5;
  }

  /* Modern Skills Section */
  .skills-modern-section {
    background: linear-gradient(180deg, #ffffff 0%, #f9fafb 100%);
  }

  .skills-gradient-text {
    background: linear-gradient(135deg, #064e06, #0f9b0f, #15803d);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 4s ease infinite;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .skills-modern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .skill-modern-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: white;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    height: 420px;
  }

  .skill-modern-card:hover {
    transform: translateY(-12px) scale(1.02);
